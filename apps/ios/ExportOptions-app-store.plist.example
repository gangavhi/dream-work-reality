<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy to ExportOptions-app-store.plist (gitignored locally if you add secrets).
  Used after archiving: xcodebuild -exportArchive -archivePath … -exportPath … -exportOptionsPlist ExportOptions-app-store.plist

  Xcode GUI path is simpler: Organizer → Distribute App → App Store Connect → Upload.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
