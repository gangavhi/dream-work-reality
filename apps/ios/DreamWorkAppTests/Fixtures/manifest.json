  "standaloneModels": [
    {
      "modelId": "trustnest.doc-type.v1",
      "artifact": "DocumentTypeClassifier.mlmodelc",
      "runtime": "coreml",
      "standalone": true,
      "dependsOn": [],
      "trainFromFixtures": "all_must_have_scannable",
      "replaces": "DocumentTypeClassifier.classifyHeuristic (fallback when confidence < 0.85)",
      "input": {
        "ocr_text_snippet": "string, max 2kb"
      },
      "output": {
        "document_type": "driversLicense | passport | stateId | ssnCard | insuranceCard | utilityBill | bankStatement | w2 | form1099 | payStub",
        "confidence": "0..1"
      }
    },
    {
      "modelId": "trustnest.passport-page.v1",
      "artifact": "PassportPageRanker.mlmodelc",
      "runtime": "coreml",
      "standalone": true,
      "dependsOn": [],
      "trainFromFixtures": ["indian_passport_noisy_multipage", "indian_passport_noisy_back"],
      "replaces": "none — selects page before parser",
      "input": {
        "pages": "array of { line_count, mrz_line_count, noise_ratio, has_surname_label, has_pin }"
      },
      "output": {
        "biodata_page_index": "int",
        "confidence": "0..1"
      }
    },
    {
      "modelId": "trustnest.field-label.v1",
      "artifact": "FieldLabelMapper.mlmodelc",
      "runtime": "coreml",
      "standalone": true,
      "dependsOn": [],
      "trainFromFixtures": ["us_passport_biodata_label_noise", "us_passport_clean_mrz"],
      "replaces": "none — hint only, merged like PDF417",
      "input": {
        "document_type": "string",
        "label": "string",
        "value": "string"
      },
      "output": {
        "profile_key": "string | null",
        "confidence": "0..1"
      }
