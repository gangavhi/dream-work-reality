// Paths match `cargo build --target …` output from the "Build Rust Core (iOS)" Run Script phase.
// Simulator picks arm64 vs x86_64 automatically; device archives use iphoneos + aarch64-apple-ios.

RUST_PROFILE = debug
RUST_PROFILE[config=Release] = release

OTHER_LDFLAGS[sdk=iphonesimulator*][arch=arm64] = $(inherited) -L$(SRCROOT)/../../core/target/aarch64-apple-ios-sim/$(RUST_PROFILE) -ldreamwork_core
OTHER_LDFLAGS[sdk=iphonesimulator*][arch=x86_64] = $(inherited) -L$(SRCROOT)/../../core/target/x86_64-apple-ios/$(RUST_PROFILE) -ldreamwork_core
OTHER_LDFLAGS[sdk=iphoneos*] = $(inherited) -L$(SRCROOT)/../../core/target/aarch64-apple-ios/$(RUST_PROFILE) -ldreamwork_core
